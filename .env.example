# Copy to .env (never commit .env). Easiest: leave cookie fields empty and connect from the
# app's Settings page, which fills them in for you after testing them.
LTUID_V2=
LTOKEN_V2=
LTMID_V2=
ACCOUNT_ID_V2=
ACCOUNT_MID_V2=
COOKIE_TOKEN_V2=
GENSHIN_UID=
GENSHIN_REGION=
# Optional: port for http://127.0.0.1:<PORT> (default 8765)
PORT=
